{
  "name": "afaaq-arab-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "materialize:hero": "node scripts/materialize-home-hero.mjs",
    "dev": "npm run materialize:hero && next dev",
    "build": "npm run materialize:hero && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:site-url": "node --experimental-strip-types scripts/test-site-url.mjs",
    "test:content": "node --experimental-strip-types scripts/validate-content.mjs",
    "test:hero": "node scripts/test-home-hero.mjs",
    "check": "npm run test:site-url && npm run test:content && npm run test:hero && npm run lint && npm run typecheck",
    "vercel-build": "npm run materialize:hero && npm run check && next build"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
